'use strict';
// Not named `.js`: `node --test` runs every script under `test/` as a test file.
const buffer = new Int32Array(1);

// The bound belongs to the slot the sum is stored in, so it is read off the slot: -1
// survives a signed slot and not an unsigned one, which is what gives the width its sign.
buffer[0] = -1;
const slotLimit = 2 ** (8 * buffer.BYTES_PER_ELEMENT - (buffer[0] === -1 ? 1 : 0)) - 1;

function storeSum(a, b) {
  if (!Number.isInteger(a) || !Number.isInteger(b))
    throw new TypeError('size is not an integer');
  if (a < 0 || b < 0 || b > slotLimit - a)
    throw new RangeError('size overflow');
  buffer[0] = a + b;
  return buffer[0];
}

module.exports = { storeSum };
